        <mxCell id="E4" value="gallery V" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="C2" target="F5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="E5" value="identity + attrs" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="D2" target="T1">
          <mxGeometry relative="1" as="geometry"/>
