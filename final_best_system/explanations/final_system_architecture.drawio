        <mxCell id="E17" value="pairs" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="T2" target="T4">
          <mxGeometry relative="1" as="geometry"/>
