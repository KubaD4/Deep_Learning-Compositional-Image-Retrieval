        <mxCell id="E7" value="attrs" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="D2" target="T3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="E8" value="attribute names" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="D2" target="C4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="E9" value="official GT" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="D3" target="F6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="E10" value="signed edits" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="D4" target="M1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="E11" value="signed edits" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="D4" target="F2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="E12" value="embed prompts" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="C3" target="C4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="E13" value="mean + normalize + subtract" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="C4" target="C5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="E14" value="d_j" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="C5" target="M1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
