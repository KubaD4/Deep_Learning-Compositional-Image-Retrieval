        <mxCell id="E19" value="batch" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="T4" target="T5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="E20" value="positives/negatives" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="T5" target="M6">
          <mxGeometry relative="1" as="geometry"/>
