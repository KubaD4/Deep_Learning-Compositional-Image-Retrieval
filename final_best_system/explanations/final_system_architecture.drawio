        <mxCell id="E3" value="s" style="endArrow=block;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="C2" target="M1">
          <mxGeometry relative="1" as="geometry"/>
